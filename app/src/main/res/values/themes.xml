<resources>

    <style name="Base.Theme.Militant" parent="Theme.Material3.Light.NoActionBar">
        <!-- Warna utama -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Warna latar & teks -->
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/dark_gray</item>
    </style>

    <!-- Splash screen style -->
    <style name="Base.Theme.Militant.Splash.FullScreen" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- No ActionBar Theme -->
    <style name="Base.Theme.Militant.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Overlay -->
    <style name="Base.Theme.Militant.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Base.Theme.Militant.PopupOverlay" parent="ThemeOverlay.Material3.Light" />
</resources>
