<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/events.detail.layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.EventDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/detail.event.appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Base.Theme.Militant.AppBarOverlay">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/detail.event.collapsing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:contentScrim="?attr/colorPrimary"
            app:expandedTitleMarginEnd="64dp"
            app:expandedTitleMarginStart="48dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <ImageView
                android:id="@+id/img_detail_event_photo"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:contentDescription="@string/events_descriptions"
                android:fitsSystemWindows="true"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                tools:ignore="MissingConstraints"
                tools:src="@drawable/paolo_maldini" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/detail.event.toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:popupTheme="@style/Base.Theme.Militant.PopupOverlay" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail.event.nestedscrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_detail_events_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingLeft="13dp"
                android:paddingTop="32dp"
                android:paddingRight="13dp"
                android:text='@{detailEvents.name}'
                android:textAlignment="textStart"
                android:textSize="25sp"
                android:textStyle="bold"
                tools:ignore="MissingConstraints"
                tools:text="@string/events_name" />

            <TextView
                android:id="@+id/tv_detail_events_owner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingLeft="13dp"
                android:paddingTop="10dp"
                android:paddingRight="13dp"
                android:text='@{detailEvents.owner}'
                android:textAlignment="textStart"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="@id/tv_detail_events_name"
                app:layout_constraintTop_toBottomOf="@id/tv_detail_events_name"
                tools:text="@string/events_summary" />

            <TextView
                android:id="@+id/tv_detail_events_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingLeft="13dp"
                android:paddingTop="10dp"
                android:paddingRight="13dp"
                android:text='@{detailEvents.time}'
                android:textAlignment="textStart"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="@id/tv_detail_events_owner"
                app:layout_constraintTop_toBottomOf="@id/tv_detail_events_owner"
                tools:text="@string/events_summary" />

            <TextView
                android:id="@+id/tv_detail_events_qouta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingLeft="13dp"
                android:paddingTop="10dp"
                android:paddingRight="13dp"
                android:text='@{detailEvents.qouta}'
                android:textAlignment="textStart"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="@id/tv_detail_events_time"
                app:layout_constraintTop_toBottomOf="@id/tv_detail_events_time"
                tools:text="@string/events_summary" />

            <TextView
                android:id="@+id/tv_detail_events_remaining_qouta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingLeft="13dp"
                android:paddingTop="10dp"
                android:paddingRight="13dp"
                android:text='@{detailEvents.qouta}'
                android:textAlignment="textStart"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="@id/tv_detail_events_qouta"
                app:layout_constraintTop_toBottomOf="@id/tv_detail_events_qouta"
                tools:text="@string/events_summary" />

            <TextView
                android:id="@+id/tv_detail_events_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingLeft="13dp"
                android:paddingTop="10dp"
                android:paddingRight="13dp"
                android:text='@{detailEvents.descriptions}'
                android:textAlignment="textStart"
                app:layout_constraintStart_toStartOf="@id/tv_detail_events_remaining_qouta"
                app:layout_constraintTop_toBottomOf="@id/tv_detail_events_remaining_qouta"
                tools:text="@string/events_descriptions" />

            <Button
                android:id="@+id/btn_detail_events_registration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_event_strRegister"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_detail_events_description" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_favorite_outline"
        app:layout_anchor="@id/detail.event.appbar"
        app:layout_anchorGravity="bottom|right|end"></com.google.android.material.floatingactionbutton.FloatingActionButton>
</androidx.coordinatorlayout.widget.CoordinatorLayout>