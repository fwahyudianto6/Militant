<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/account_nested_scrview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:colorBackground"
        android:paddingBottom="16dp">

        <!-- Header background -->
        <View
            android:id="@+id/header_bg"
            android:layout_width="0dp"
            android:layout_height="275dp"
            android:background="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/account_tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/menu_account"
            android:textColor="?android:textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Profile Picture -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/account_civUser"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:padding="16dp"
            android:src="@drawable/placeholder"
            android:textColor="?android:textColorPrimary"
            app:civ_border_width="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/account_tvTitle" />

        <!-- Username -->
        <TextView
            android:id="@+id/account_tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/developer_name"
            android:textColor="?android:textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/account_civUser" />

        <!-- Location -->
        <TextView
            android:id="@+id/account_tvUserLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/developer_location"
            android:textColor="?android:textColorPrimary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/account_tvUsername" />

        <!-- Theme Switch Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/theme_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            android:background="@drawable/bg_card_white"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_bg">

            <ImageView
                android:id="@+id/theme_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/contents_description"
                android:src="@drawable/ic_dark_mode"
                android:tint="?attr/colorOnSurface"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="UseAppTint,ImageContrastCheck" />

            <TextView
                android:id="@+id/theme_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/dark_mode"
                android:textColor="?android:textColorPrimary"
                app:layout_constraintBottom_toBottomOf="@id/theme_icon"
                app:layout_constraintEnd_toStartOf="@id/account_swtTheme"
                app:layout_constraintStart_toEndOf="@id/theme_icon"
                app:layout_constraintTop_toTopOf="@id/theme_icon" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/account_swtTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/theme_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/theme_icon" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
